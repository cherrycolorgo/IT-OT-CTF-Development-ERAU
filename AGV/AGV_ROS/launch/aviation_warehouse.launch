<launch>
  <!-- Aviation Warehouse + TurtleBot3 Burger -->

  <arg name="model" default="$(env TURTLEBOT3_MODEL)" doc="TurtleBot3 model: burger, waffle, waffle_pi"/>
  <arg name="x_pos" default="0.0"/>
  <arg name="y_pos" default="0.0"/>
  <arg name="z_pos" default="0.05"/>

  <!-- Start Gazebo with the aviation warehouse world -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find aviation_warehouse)/worlds/aviation_warehouse.world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <!-- Load TurtleBot3 URDF -->
  <param name="robot_description"
         command="$(find xacro)/xacro --inorder
                  $(find turtlebot3_description)/urdf/turtlebot3_$(arg model).urdf.xacro"/>

  <!-- Spawn the robot at the yellow pad -->
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_urdf"
        args="-urdf -model turtlebot3_$(arg model)
              -x $(arg x_pos) -y $(arg y_pos) -z $(arg z_pos)
              -param robot_description"/>

  <!-- Robot state publisher -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
    <param name="publish_frequency" type="double" value="50.0"/>
  </node>

</launch>
