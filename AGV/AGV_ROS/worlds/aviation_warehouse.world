<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="aviation_warehouse">

    <!-- ── Lighting ── -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <light name="ceiling_light_1" type="point">
      <pose>0 0 5.5 0 0 0</pose>
      <diffuse>1 1 0.95 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>20</range><linear>0.05</linear></attenuation>
    </light>

    <light name="ceiling_light_2" type="point">
      <pose>10 0 5.5 0 0 0</pose>
      <diffuse>1 1 0.95 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>20</range><linear>0.05</linear></attenuation>
    </light>

    <light name="ceiling_light_3" type="point">
      <pose>-10 0 5.5 0 0 0</pose>
      <diffuse>1 1 0.95 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>20</range><linear>0.05</linear></attenuation>
    </light>

    <!-- ── Physics ── -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <!-- ── Ground plane ── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>60 40</size></plane></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════
         WAREHOUSE OUTER WALLS  (25 m × 18 m)
         ══════════════════════════════════════ -->

    <!-- North wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 9 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>25 0.2 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>25 0.2 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -9 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>25 0.2 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>25 0.2 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>12.5 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 18 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 18 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-12.5 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 18 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 18 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════
         SHELVING ROWS  (6 rows × 4 bays each)
         Rows run East–West.  3 aisles between them.
         Row Y positions: ±6, ±3.5, ±1  (pairs)
         Aisle widths ~2 m each.
         ══════════════════════════════════════ -->

    <!-- Helper macro: each shelf bay = 2 m wide, 0.4 m deep, 1.8 m tall -->
    <!-- Row A  (y=+6.5) -->
    <model name="shelf_A1"><static>true</static><pose>-9  6.5 0.9 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>2 0.4 1.8</size></box></geometry></collision>
